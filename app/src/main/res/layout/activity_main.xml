<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1E3A5F"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/pantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOPE'S PANTRY"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#6A4C93"
        android:layout_marginBottom="15dp" />

    <TextView
        android:id="@+id/emptyPantryMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is currently empty."
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="20dp" />

    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1976D2"
        android:layout_marginTop="20dp" />


</LinearLayout>