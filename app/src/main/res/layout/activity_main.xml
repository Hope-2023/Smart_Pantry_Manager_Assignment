<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/appTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#1E3A5F"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/pantryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOPE'S PANTRY"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#6A4C93"
        android:layout_marginBottom="15dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/addIngredientButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:text="+ Add Item"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/suggestRecipesButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:textSize="14sp"
            android:text="Recipes"
            android:textColor="#000000"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:text="Settings"
            android:textColor="#000000"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyPantryMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty. Click '+ Add Item' to populate your pantry."
        android:visibility="gone"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#2C096B"
        android:gravity="center"
        android:padding="20dp" />

    <ListView
        android:id="@+id/pantryListView"
        android:layout_width="match_parent"
        android:layout_height="789dp"
        android:layout_weight="1" />

</LinearLayout>