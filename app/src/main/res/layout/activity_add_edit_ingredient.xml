<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/formTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADD INGREDIENT"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1E3A5F"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/editIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textSize="10sp"
        android:layout_marginBottom="14dp"
        android:hint="Ingredient Name (e.g. egg, flour, milk)"
        android:inputType="text" />

    <EditText
        android:id="@+id/editIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textSize="10sp"
        android:layout_marginBottom="14dp"
        android:hint="Quantity (e.g. 2, 200)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/editIngredientUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textSize="10sp"
        android:layout_marginBottom="14dp"
        android:hint="Unit (e.g. pcs, g, ml)"
        android:inputType="text" />

    <EditText
        android:id="@+id/editIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textSize="10sp"
        android:layout_marginBottom="14dp"
        android:hint="Expiry Date (YYYY-MM-DD) - Optional"
        android:inputType="date" />

    <Button
        android:id="@+id/saveIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="#0B0B0B"
        android:textStyle="bold"
        android:textSize="10sp"
        android:text="Save Ingredient" />

    <Button
        android:id="@+id/deleteIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#0B0B0B"
        android:textStyle="bold"
        android:text="Delete Ingredient"
        android:visibility="gone" />

</LinearLayout>